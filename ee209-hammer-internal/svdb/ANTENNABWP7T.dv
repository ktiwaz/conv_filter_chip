# CALIBRE-LVS DISCREPANCY VIEWER TCL FILE 
# FILE: svdb/ANTENNABWP7T.dv
dv_start unmatched                                
dv_cell {ANTENNABWP7T} {ANTENNABWP7T} unmatched
dv_obj_count -transformed_nets {4 3} -transformed_inst {1 1} -transformed_port {3 3}
dv_discrep 1 {Incorrect Nets} -inst_count { 2 2}
dv_discrep_line {Net } -lnet {VSS} {                                                   } -snet {VSS} {}
dv_discrep_line {    } -lnet {6} {                                                    }
dv_discrep_line {--- 2 Connections On This Net ---                         --- 2 Connections On This Net ---}
dv_discrep_line {}
dv_discrep 2 {Property Errors}
dv_discrep_line {} -ldev {D0} {} -lloc {(0.140,0.520)} {  D(DN)                                    } -sdev {DDI3} {  D(DN)}
dv_discrep_line {}  {a} {: }  {0.2037 sq u} {                                            }  {a} {: }  {100 sq u} {           }  {      99.8%} {}
dv_discrep_line {}
dv_end
