; Example Bindkeys for Layout Productivity
hiSetBindKeys( "Layout" list(
		list("None<Key>`" 
			"leSetEntryLayer( list(\"POLY1\" \"drawing\")) 
			leSetLayerVisible(list(\"POLY1\" \"drawing\") t) 
			leSetLayerVisible(list(\"POLY1\" \"dummy\") t) 
			leSetLayerVisible(list(\"POLY1\" \"pin\") t) 
			leSetLayerVisible(list(\"PIMP\" \"drawing\") t) 
			leSetLayerVisible(list(\"NIMP\" \"drawing\") t) 
			leSetLayerVisible(list(\"DIFF\" \"drawing\") t) 
			leSetLayerVisible(list(\"DIFF\" \"dummy\") t) 
			leSetLayerVisible(list(\"CONT\" \"drawing\") t) 
			leSetLayerVisible(list(\"NWELL\" \"drawing\") t) 
			leSetLayerVisible(list(\"WELLBODY\" \"drawing\") t) 
			hiRedraw()") 
		list("None<Key>1" 
			"leSetEntryLayer( list(\"METAL1\" \"drawing\")) 
