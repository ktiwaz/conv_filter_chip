// Tang Primer 20K dock: HDMI out test patterns (hdmi_test_top 640x480, hdmi720_top 720p).
// TMDS pairs from Sipeed's TangPrimer-20K-example HDMI/src/dk_video.cst.
// These are true-LVDS pins (apycula refuses emulated LVDS on them), so the
// outputs are TLVDS_OBUF with the default LVDS IO_TYPE, as in Sipeed's own
// HDMI demo on this board. Banks 0/1 run at 3.3 V (the PMODs and LEDs share
// them); the other pins in those banks stay LVCMOS33.

IO_LOC  "clk27" H11;
IO_PORT "clk27" IO_TYPE=LVCMOS33;
IO_LOC  "rst_n" T10;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// hdmi720_top only: button S1, hold to show the live layout (1.5 V bank)
IO_LOC  "btn_n" T3;
IO_PORT "btn_n" IO_TYPE=LVCMOS15;

IO_LOC  "tmds_clk_p" G16;
IO_PORT "tmds_clk_p" PULL_MODE=NONE;
IO_LOC  "tmds_d_p[0]" H14;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE;
IO_LOC  "tmds_d_p[1]" J15;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE;
IO_LOC  "tmds_d_p[2]" K14;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE;
// Negative legs: one pin per port (with Sipeed's "P,N" pair syntax nextpnr
// puts the positive leg on the second pin)
IO_LOC  "tmds_clk_n" H15;
IO_LOC  "tmds_d_n[0]" H16;
IO_LOC  "tmds_d_n[1]" K16;
IO_LOC  "tmds_d_n[2]" K15;

IO_LOC  "led_n[0]" L16;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[1]" L14;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[2]" N14;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[3]" N16;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[4]" A13;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[5]" C13;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33;

