// Tang Primer 20K dock pinout, from Sipeed's TangPrimer-20K-example
// (UART/UART_HELLO and Litex/sipeed_tang_primer_20k constraints).

// 27 MHz oscillator
IO_LOC  "clk27" H11;
IO_PORT "clk27" IO_TYPE=LVCMOS33;

// Onboard debugger USB UART (names from the FPGA's point of view)
IO_LOC  "uart_tx" M11;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "uart_rx" T13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Push buttons S0 (reset), S1 (next), S2 (prev), active low; T3/T2 are in a 1.5 V bank
IO_LOC  "rst_n" T10;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "btn_next_n" T3;
IO_PORT "btn_next_n" IO_TYPE=LVCMOS15;
IO_LOC  "btn_prev_n" T2;
IO_PORT "btn_prev_n" IO_TYPE=LVCMOS15;

// LEDs, active low
IO_LOC  "led_n[0]" L16;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[1]" L14;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[2]" N14;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[3]" N16;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[4]" A13;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[5]" C13;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33;
