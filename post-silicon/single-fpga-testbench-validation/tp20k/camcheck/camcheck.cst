// Tang Primer 20K dock: UART, reset, LEDs and the DVP camera port.
// Camera pins from Sipeed's TangPrimer-20K-example Cam2HDMI/OV5640_HDMI720P_DDR3.

IO_LOC  "clk27" H11;
IO_PORT "clk27" IO_TYPE=LVCMOS33;
IO_LOC  "uart_tx" M11;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "uart_rx" T13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "rst_n" T10;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "led_n[0]" L16;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[1]" L14;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[2]" N14;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[3]" N16;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[4]" A13;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33;
IO_LOC  "led_n[5]" C13;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33;

// DVP camera. Sipeed's camera example declares these LVCMOS25, but the banks
// are shared with the UART, LEDs and clock, which work as LVCMOS33, and one
// bank can only have one I/O voltage. SCL/SDA get weak pull-ups in case the
// camera module has none.
IO_LOC  "cmos_scl" F14;
IO_PORT "cmos_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "cmos_sda" F16;
IO_PORT "cmos_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "cmos_vsync" G15;
IO_PORT "cmos_vsync" IO_TYPE=LVCMOS33;
IO_LOC  "cmos_href" G14;
IO_PORT "cmos_href" IO_TYPE=LVCMOS33;
IO_LOC  "cmos_pclk" F13;
IO_PORT "cmos_pclk" IO_TYPE=LVCMOS33;
IO_LOC  "cmos_xclk" G12;
IO_PORT "cmos_xclk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "cmos_rst_n" L13;
IO_PORT "cmos_rst_n" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "cmos_pwdn" C10;
IO_PORT "cmos_pwdn" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "cmos_db[0]" T12;
IO_PORT "cmos_db[0]" IO_TYPE=LVCMOS33;
IO_LOC  "cmos_db[1]" T11;
IO_PORT "cmos_db[1]" IO_TYPE=LVCMOS33;
IO_LOC  "cmos_db[2]" P11;
IO_PORT "cmos_db[2]" IO_TYPE=LVCMOS33;
IO_LOC  "cmos_db[3]" R11;
IO_PORT "cmos_db[3]" IO_TYPE=LVCMOS33;
IO_LOC  "cmos_db[4]" M15;
IO_PORT "cmos_db[4]" IO_TYPE=LVCMOS33;
IO_LOC  "cmos_db[5]" M14;
IO_PORT "cmos_db[5]" IO_TYPE=LVCMOS33;
IO_LOC  "cmos_db[6]" J16;
IO_PORT "cmos_db[6]" IO_TYPE=LVCMOS33;
IO_LOC  "cmos_db[7]" J14;
IO_PORT "cmos_db[7]" IO_TYPE=LVCMOS33;
